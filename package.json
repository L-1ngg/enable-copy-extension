{
  "name": "enable-copy-extension",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json --noEmit",
    "build": "bun run typecheck && bun scripts/build.ts",
    "pretest": "bun run build",
    "test": "node --test tests/regression.test.ts",
    "pretest:popup": "bun run build",
    "test:popup": "node --test tests/popup-layout.test.ts"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "playwright": "1.58.2",
    "typescript": "5.9.3"
  }
}
