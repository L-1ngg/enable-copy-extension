{
  "name": "enable-copy-extension",
  "private": true,
  "packageManager": "bun@1.3.12",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && node scripts/build.mjs",
    "pretest": "bun run build",
    "test": "node --test tests/regression.cjs",
    "pretest:popup": "bun run build",
    "test:popup": "node --test tests/popup-layout.cjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "playwright": "1.58.2"
  }
}
